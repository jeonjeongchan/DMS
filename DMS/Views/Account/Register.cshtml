<div class="col-xl-6 ml-auto mr-auto">
    <div class="card p-4 rounded-plus bg-faded">
        <form id="RegisterForm" asp-controller="Account" asp-action="Register" method="post">
            <div asp-validation-summary="All" class="alert alert-primary text-dark"></div>
            <div class="form-group">
                <label class="form-label" asp-for="MEMBER_ID">아이디</label>
                <input type="text" asp-for="MEMBER_ID" class="form-control" placeholder="아이디" value="" required="required" />
                <span class="invalid-feedback" asp-validation-for="MEMBER_ID">아이디를 입력해주세요.</span>
            </div>
            <div class="form-group">
                <label class="form-label" asp-for="PASSWORD">비밀번호</label>
                <input type="PASSWORD" asp-for="PASSWORD" class="form-control" placeholder="비밀번호" value="" required="required" />
                <span class="invalid-feedback" asp-validation-for="PASSWORD">비밀번호를 입력해주세요.</span>
            </div>
            <div class="form-group">
                <label class="form-label" asp-for="NAME">이름</label>
                <input type="text" asp-for="NAME" class="form-control" placeholder="이름" value="" required="required" />
                <span class="invalid-feedback" asp-validation-for="NAME">이름을 입력해주세요.</span>
            </div>
            <div class="form-group">
                <label class="form-label" asp-for="BIRTH_DATE">생년월일</label>
                <input type="date" name="BIRTH_DATE" asp-for="BIRTH_DATE" class="form-control" placeholder="생년월일" value="" required="required" />
                <span class="invalid-feedback" asp-validation-for="BIRTH_DATE">생년월일을 입력해주세요.</span>
            </div>
            <div class="form-group">
                <label class="form-label" asp-for="POSITION">직책</label>
                <select class="custom-select form-control">
                    <option selected="">직책</option>
                    <option value="개발">개발</option>
                    <option value="영업">영업</option>
                </select>
            </div>
            <div class="form-group">
                <label class="form-label" asp-for="RESIGN_DATE">입사일</label>
                    <input type="date" name="RESIGN_DATE" asp-for="RESIGN_DATE" class="form-control" placeholder="생년월일" value="" required="required" />
                </div>
            <div class="form-group">
                <label class="form-label">성별</label>
                <select class="custom-select form-control">
                    <option selected="">성별</option>
                    <option value="남자">남자</option>
                    <option value="여자">여자</option>
                </select>
            </div>
            <div class="row no-gutters">
                <div class="col-md-6 ml-auto text-right">
                    <button id="RegisterSubmit" type="submit" class="btn btn-block btn-danger btn-lg mt-3">계정 등록</button>
                </div>
            </div>
        </form>
    </div>
</div>

