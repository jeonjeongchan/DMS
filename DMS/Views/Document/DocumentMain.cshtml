                        <button type="button" id="documentDelete" class="btn btn-danger" data-toggle="modal">삭제</button>
                        <button type="button" id="documentRevision" class="btn btn-secondary" data-toggle="modal">개정</button>
                    </div>
                    <table id="DocumentMainTable" class="table table-bordered table-hover table-striped w-100">
