<!-- 문서모달 -->
<div class="modal fade" id="documentFormModal" tabindex="-1" role="dialog" aria-hidden="true">
    <div class="modal-dialog" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="documentFormModalLabel"></h5>
                <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>
            <div class="modal-body">
                <form id="documentForm">
                    @*<div class="alert alert-primary text-dark"></div>*@
                    <div class="form-group">
                        <label class="form-label" for="doc_class_name">
                            문서 분류
                        </label>
                        <select class="select2 form-control w-100" id="doc_class_name">
                            <optgroup label="문서분류선택">
                                <option value="">문서분류선택</option>
                                @foreach (var item in ViewBag.docClasses)
                                {
                                    <option value="@item.SEQ">@item.NAME</option>
                                    @if (item.Children.Count > 0)
                                    {
                                        @foreach (var child in item.Children)
                                        {
                                            <option value="@child.SEQ">@child.NAME</option>
                                        }

                                    }
                                }
                            </optgroup>
                        </select>
                    </div>
                    <div class="form-group">
                        <label class="form-label" for="title">문서제목</label>
                        <input type="text" id="title" class="form-control" placeholder="">
                    </div>
                    <div class="form-group">
                        <label class="form-label" for="content">내용</label>
                        <textarea class="form-control" id="content" rows="5"></textarea>
                    </div>
                    @*<div class="form-group">
                            <label class="form-label" for="state">상태</label>
                            <input type="text" id="state" class="form-control" placeholder="">
                        </div>*@
                    <div class="form-group">
                        <label class="form-label" for="create_user">작성자</label>
                        <input type="text" id="create_user" class="form-control" placeholder="">
                    </div>
                    <div class="form-group">
                        <label class="form-label" for="modify_user">수정자</label>
                        <input type="text" id="modify_user" class="form-control" placeholder="">
                    </div>
                    <div class="form-group">
                        <label class="form-label" for="create_date">작성일</label>
                        <input class="form-control" id="create_date" type="date" name="date">
                    </div>
                    <div class="form-group">
                        <label class="form-label" for="modify_date">수정일</label>
                        <input class="form-control" id="modify_date" type="date" name="date">
                    </div>
                    <div class="form-group">
                        <label class="form-label" for="example-number">리비전</label>
                        <input class="form-control" id="revision" type="number" name="number" value="" readonly="readonly">
                    </div>
                    <div id="fileDownload" class="form-group">
                        @*<label id="fileDownloadList" class="form-label" for="file">첨부 파일</label>
                            <input type="file" readonly="" class="form-control-plaintext" id="file" value="">*@
                    </div>
                    <div id="fileUpload" class="form-group">
                        <label class="form-label">파일 등록</label>
                        <div class="dropzone" id="documentDropzone">
                            <div class="dz-message needsclick">
                                파일을 이곳에 드래그하거나 클릭하여 업로드하세요.
                            </div>
                        </div>
                    </div>
                    <div class="panel-content border-faded border-left-0 border-right-0 border-bottom-0 d-flex flex-row">
                        <button id="documentCreateSubmit" class="btn btn-primary ml-auto">등록</button>
                        <button id="documentEditSubmit" class="btn btn-primary ml-auto">수정</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>


@section ScriptsBlock {
    <script type="text/javascript">$('#js-page-content').smartPanel();</script>
    <script src="~/js/statistics/peity/peity.bundle.js"></script>
    <script src="~/js/statistics/flot/flot.bundle.js"></script>
    <script src="~/js/statistics/easypiechart/easypiechart.bundle.js"></script>
    <script src="~/js/datagrid/datatables/datatables.bundle.js"></script>
    <script src="~/js/formplugins/dropzone/dropzone.js"></script>
    <script>// 드롭존 (첨부파일)
        Dropzone.autoDiscover = false;
        const documentDropzone = new Dropzone("#documentDropzone", {
            url: "#",  // 서버 업로드 경로
            autoProcessQueue: false,  // 자동 업로드 방지
            maxFiles: 5,  // 업로드할 최대 파일 개수
            maxFilesize: 20,  // 파일 크기 제한 (MB)
            acceptedFiles: null, // 허용할 파일 유형
            addRemoveLinks: true,  // 파일 삭제 버튼 추가
            dictDefaultMessage: "여기에 파일을 드래그하거나 클릭하여 업로드하세요.",
            dictRemoveFile: "파일 삭제",
            dictMaxFilesExceeded: "최대 5개의 파일만 업로드할 수 있습니다.",
            init: function () {
                this.on("addedfile", function (file) {
                    if (this.files.length > 5) {
                        this.removeFile(file); // 초과된 파일 삭제
                        alert("최대 5개의 파일만 업로드할 수 있습니다.");
                    }
                });
            }

        });

        //function toggleFiles() {
        //    $("#fileContainer").toggle(); // jQuery의 toggle() 함수 사용하여 보이기/숨기기 전환
        //}

        function downloadFile(fileName) {
            const url = `/File/${encodeURIComponent(fileName)}`;
            window.location.href = url;
        }

        function fileRemove(seq) {
            if (!confirm("정말로 삭제하시겠습니까?")) {
                return; // 사용자가 취소하면 함수 종료
            }

            fetch(`/file/${seq}`, {
                method: "DELETE"
            })
                .then(response => {
                    if (!response.ok) {
                        throw new Error("파일 삭제 실패");
                    }
                    return response.text();
                })
                .then(data => {
                    alert(data); // 삭제 성공 메시지 출력
                    location.reload(); // 페이지 새로고침 (삭제된 파일 반영)
                })
                .catch(error => {
                    console.error("삭제 오류:", error);
                    alert("파일 삭제 중 오류가 발생했습니다.");
                });
        }


        function dateChange(dateInput) {
            if (dateInput != "" && dateInput != null) {
                var dateObject = new Date(dateInput);
                var isoDateString = dateObject.toISOString();

                return isoDateString;

            } else {
                return null;
            }

        }

        function createFormDateChange(today) {
            if (today == null || today == undefined) {
                today = new Date();
                var dd = String(today.getDate()).padStart(2, '0');
                var mm = String(today.getMonth() + 1).padStart(2, '0');
                var yyyy = today.getFullYear();
                today = yyyy + '-' + mm + '-' + dd;
            } else {
                today = today.substring(0, 10);
            }


            return today;
        }


        function isValidForm() {
            // 빈 칸 체크
            if ($('#title').val() === '') {
                alert('제목을 입력해주세요');
                return false;
            }

            if ($('#doc_class_name').val() === '') {
                alert('문서분류를 선택해주세요');
                return false;
            }

            if ($('#content').val() === '') {
                alert('내용을 입력해주세요');
                return false;
            }

            // 글자수 체크 (예시로 제목, 내용 글자수 제한)
            if ($('#title').val().length > 100) {
                alert('문서 제목은 100자 이하로 입력해주세요.');
                return false;
            }

            if ($('#content').val().length > 500) {
                alert('내용은 500자 이하로 입력해주세요.');
                return false;
            }

            return true; // 유효성 통과하면 true 반환
        }


        // 문서상세
        function DocumentDetail(row) {

            $('#documentForm')[0].reset();
            const oid = row.getAttribute('data-oid');

            $('#documentFormModalLabel').text('문서상세');
            $('input').prop('readonly', true);
            $('textarea').prop('readonly', true);
            $('#fileUpload').hide();
            $('#doc_class_name').attr('disabled', 'disabled');
            $('#documentCreateSubmit').hide();
            $('#documentEditSubmit').hide();
            $('#fileDownload').show();

            $.ajax({
                url: '/Document/' + oid,
                type: 'GET',
                success: function (data) {
                    debugger;
                    $('#documentFormModal').modal('show');
                    $('#title').val(data.title);
                    $('#content').val(data.content);

                    if (data.creatE_DATE != undefined || data.creatE_DATE != null) {
                        $('#create_date').val(createFormDateChange(data.creatE_DATE));
                    } else {
                        $('#create_date').val(null);
                    }

                    if (data.modifY_DATE != undefined || data.modifY_DATE != null) {
                        $('#modify_date').val(createFormDateChange(data.modifY_DATE));
                    } else {
                        $('#modify_date').val(null);
                    }
                    $('#doc_class_name').val(data.doC_CLASS_SEQ);
                    $('#doc_class_name').change();
                    $('#create_user').val(data.creatE_USER);
                    $('#modify_user').val(data.modifY_USER);
                    $('#revision').val(data.revision);
                    $('#state').val(data.state);

                    const fileList = $("#fileDownload");
                    const fileLabelName = `<label class="form-label" for="file">첨부 파일</label>`;
                    fileList.html(fileLabelName);

                    //파일 목록을 동적으로 추가
                    if (data.fileList != null) {
                        data.fileList.$values.forEach((i, index) => {
                            const fileHtml = `
                                                <div style="display: flex; align-items: center; gap: 10px;">
                                                 <input type="text" readonly="" class="form-control-plaintext" value="${i}" readonly />
                                                 <input type="button" value="다운로드" onclick="downloadFile('${i}')" />
                                                </div>
                                            `;

                            fileList.append(fileHtml);
                        });
                    }



                },
                error: function (xhr, status, error) {
                    console.log('Error:', error);
                }
            });
        }


        $(document).ready(function () {

            var documentId = null;


            // 문서편집
            $('#documentEdit').on('click', function () {
                $('#documentForm')[0].reset();
                documentId = null;
                var count = $("#DocumentMainTable tr").filter(function () {
                    return $(this).hasClass('selected');
                }).length;

                if (count > 1) {
                    alert("문서 하나만 선택해주세요.");
                } else if (count == 0) {
                    alert("문서 하나를 선택해주세요.");
                } else {
                    documentId = $("tbody tr.selected").data("oid");

                    $('#documentFormModalLabel').text('문서편집');
                    $('#documentForm input').removeAttr('readonly');
                    $('#fileUpload').show();
                    $('#fileDownload').show();
                    $('#documentForm textarea').removeAttr('readonly');
                    $('#create_user').attr('readonly', 'readonly');
                    $('#modify_user').attr('readonly', 'readonly');
                    $('#create_date').attr('readonly', 'readonly');
                    $('#modify_date').attr('readonly', 'readonly');
                    $('#doc_class_name').removeAttr('disabled', 'disabled');
                    $('#state').attr('readonly', 'readonly');
                    $('#revision').attr('readonly', 'readonly');
                    $('#documentCreateSubmit').hide();
                    $('#documentEditSubmit').show();

                    $.ajax({
                        url: '/Document/' + documentId,
                        type: 'GET',
                        success: function (data) {

                            $('#documentFormModal').modal('show');
                            $('#title').val(data.title);
                            $('#content').val(data.content);

                            if (data.creatE_DATE != undefined || data.creatE_DATE != null) {
                                $('#create_date').val(createFormDateChange(data.creatE_DATE));
                            } else {
                                $('#create_date').val(null);
                            }

                            if (data.modifY_DATE != undefined || data.modifY_DATE != null) {
                                $('#modify_date').val(createFormDateChange(data.modifY_DATE));
                            } else {
                                $('#modify_date').val(null);
                            }
                            $('#doc_class_name').val(data.doC_CLASS_SEQ);
                            $('#doc_class_name').change();
                            $('#create_user').val(data.creatE_USER);
                            $('#modify_user').val(data.modifY_USER);
                            $('#revision').val(data.revision);
                            $('#state').val(data.state);


                            const fileList = $("#fileDownload");
                            const fileLabelName = `<label class="form-label" for="file">첨부 파일</label>`;


                            fileList.html(fileLabelName);
                            //if (data.r_FILE_DOCUMENT.$values.length > 0) {
                            //    const toggleButtonHtml = '<button id="toggleFileList" onclick="toggleFiles()">파일 보이기/숨기기</button>';
                            //    fileList.append(toggleButtonHtml); // 라벨 바로 아래에 버튼을 추가
                            //}

                            if (data.r_FILE_DOCUMENT != null) {
                                for (var i = 0; i < data.r_FILE_DOCUMENT.$values.length; i++) {

                                    var seq = data.r_FILE_DOCUMENT.$values[i].seq;
                                    var fileName = data.r_FILE_DOCUMENT.$values[i].t_File.filE_NAME;

                                    const fileHtml = `
                                                        <div style="display: flex; align-items: center; gap: 10px;">
                                                            <input type="text" readonly="" class="form-control-plaintext" value="${fileName}" readonly />
                                                            <input type="button" value="삭제" onclick="fileRemove('${seq}')" />
                                                        </div>
                                                    `;
                                    fileList.append(fileHtml);
                                }

                            }



                        },
                        error: function (xhr, status, error) {
                            console.log('Error:', error);
                        }
                    });

                }

            });

            // 문서삭제
            $('#documentDelete').on('click', function () {
                var selectedOids = [];
                var count = $("#DocumentMainTable tr").filter(function () {
                    return $(this).hasClass('selected');
                }).length;

                $("tbody tr.selected").each(function () {
                    var oid = $(this).data("oid");
                    selectedOids.push(oid);
                });

                if (count == 0) {
                    alert("삭제할 문서를 선택해주세요.");
                } else {
                    event.preventDefault();
                    if (confirm("삭제 하시겠습니까?")) {
                        $.ajax({
                            url: '/Document/Delete',
                            type: 'DELETE',
                            contentType: 'application/json',
                            data: JSON.stringify({ OIDs: selectedOids }),
                            success: function (data) {
                                alert('문서 삭제 성공');
                                window.location.href = '/Document/DocClass';

                            },
                            error: function (xhr, status, error) {
                                console.log('Error:', error);
                                window.location.href = '/Error';
                            }
                        });
                    }
                }

            });

            // 문서등록
            $('#documentCreate').on('click', function () {

                documentId = null;
                $('#documentForm')[0].reset();
                $('#documentFormModalLabel').text('문서등록');
                $('#title').removeAttr('readonly', 'readonly');
                $('#content').removeAttr('readonly', 'readonly');
                $('#create_date').attr('readonly', 'readonly');
                $('#modify_date').attr('readonly', 'readonly');
                $('#state').attr('readonly', 'readonly');
                $('#revision').attr('readonly', 'readonly');
                $('#create_user').attr('readonly', 'readonly');
                $('#modify_user').attr('readonly', 'readonly');
                $('#doc_class_name').removeAttr('disabled', 'disabled');
                $('#fileUpload').show();
                $('#documentCreateSubmit').show();
                $('#documentEditSubmit').hide();
                $('#fileDownload').hide();
                if ($("#DocumentMainTable tr").hasClass('selected')) {
                    $("#DocumentMainTable tr").removeClass('selected');
                }
                $('#create_date').val(createFormDateChange(null));

            });


            // 문서등록 완료
            $('#documentCreateSubmit').on("click", async function () {
                event.preventDefault();
                if (isValidForm()) {
                    if (confirm("등록 하시겠습니까?")) {

                        var formData = new FormData();
                        var method = 'POST';
                        var urlMethod = '/Document';

                        formData.append("TITLE", $('#title').val());
                        formData.append("CONTENT", $('#content').val());
                        formData.append("DOC_CLASS_SEQ", $('#doc_class_name').val());

                        documentDropzone.files.forEach(function (file) {
                            formData.append("T_FILE_LIST", file);  // 각 파일을 FormData에 추가
                        });


                        const response = await fetch(urlMethod, {
                            method: method,
                            body: formData
                        })
                            .then(response => {
                                if (!response.ok) {
                                    throw new Error("문제가 발생하였습니다. 관리자에게 문의하세요.");
                                }
                                return response.json();
                            })
                            .then(data => {
                                alert(data.message);
                                window.location.href = '/Document/DocClass';
                            })
                            .catch(error => {
                                console.error("Error:", error);
                                alert("Error: " + error.message);
                            });

                    }
                }
            });

            // 문서편집 완료
            $('#documentEditSubmit').on('click', async function () {
                event.preventDefault();
                if (isValidForm()) {

                    if (confirm("수정 하시겠습니까?")) {
                        var method = 'PUT';
                        var urlMethod = '/Document/' + documentId;

                        var modifyDateChange = modifyDateChange = new Date();

                        var formData = new FormData();

                        formData.append("OID", documentId);
                        formData.append("TITLE", $('#title').val());
                        formData.append("CONTENT", $('#content').val());
                        formData.append("DOC_CLASS_SEQ", $('#doc_class_name').val());

                        documentDropzone.files.forEach(function (file) {
                            formData.append("T_FILE_LIST", file);  // 각 파일을 FormData에 추가
                        });


                        const response = await fetch(urlMethod, {
                            method: method,
                            body: formData
                        })
                            .then(response => {
                                if (!response.ok) {
                                    return response.json().then(errorData => {
                                        throw new Error(errorData.message || "문제가 발생하였습니다. 관리자에게 문의하세요.");
                                    });
                                }
                                return response.json();
                            })
                            .then(data => {
                                alert(data.message);
                                window.location.href = '/Document/DocClass';
                            })
                            .catch(error => {
                                alert(error.message);
                            });
                    }
                }
            });




            // 문서 개정
            $('#documentRevision').on('click', function () {
                var selectedOids = [];
                documentId = null;
                var count = $("#DocumentMainTable tr").filter(function () {
                    return $(this).hasClass('selected');
                }).length;

                if (count > 1) {
                    alert("문서 하나만 선택해주세요.");
                } else if (count == 0) {
                    alert("문서 하나를 선택해주세요.");
                } else {
                    if (confirm("개정 하시겠습니까?")) {
                        event.preventDefault();
                        documentId = $("tbody tr.selected").data("oid");

                        var updatedData = {
                            OID: documentId,
                        };

                        $.ajax({
                            url: '/Document/Revision',
                            type: 'PUT',
                            contentType: "application/json",
                            data: JSON.stringify(updatedData),
                            success: function (data) {
                                alert("개정 완료");
                                window.location.href = '/Document/DocClass';
                            },
                            error: function (xhr, status, error) {
                                console.log('Error:', error);
                            }
                        });

                    }
                }

            });




        });


