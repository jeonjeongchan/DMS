@using Microsoft.AspNetCore.Http
@using DMS.Models


@{
    var username = Context.Session.GetString("Username");
}
@model IEnumerable<T_Document>

@{
    ViewData["Title"] = "메인화면";
    ViewData["PageName"] = "document_main";
    ViewData["Category1"] = "문서관리";
    ViewData["Heading"] = "<i class='subheader-icon fal fa-chart-area'></i> Marketing <span class='fw-300'>문서관리</span>";
    ViewData["UserName"] = username;
    var docClasses = ViewBag.docClass as List<T_Document_Class>;
    void RenderTree(T_Document_Class item)
    {
        <text>
            <li data-id="@item.SEQ">
                <i class="fas fa-file"></i>
                @if (ViewBag.CurrentPageNum == item.SEQ)
                {
                    <a class="li-highlight" href="/Document/DocClass/@item.SEQ">@item.NAME (@item.DOC_COUNT)</a>
                }
                else
                {
                    <a href="/Document/DocClass/@item.SEQ">@item.NAME (@item.DOC_COUNT)</a>
                }

                @if (item.Children != null && item.Children.Count > 0)
                {
                    <ul>
                        @foreach (var child in item.Children)
                        {
                            RenderTree(child);
                        }
                    </ul>
                }
            </li>
        </text>
    }


}



@section HeadBlock {
    <link rel="stylesheet" media="screen, print" href="~/css/datagrid/datatables/datatables.bundle.css">
    <link rel="stylesheet" media="screen, print" href="~/css/theme-demo.css">
    <link rel="stylesheet" media="screen, print" href="~/css/formplugins/dropzone/dropzone.css">
    <link rel="stylesheet" media="screen, print" href="~/css/fa-solid.css">
    <link rel="stylesheet" media="screen, print" href="~/css/fa-brands.css">
    <link rel="stylesheet" href="~/css/modules/document.css" />
}



@{
    int index = 1;
}


<input type="hidden" id="loginUserName" value="@ViewData["UserName"]" />




<div class="row">
    <div class="col-lg-2">
        <div class="panel">
            <div class="panel-container show">
                <div class="panel-content">
                    <div class="buttons">
                        <button type="button" id="documentClassAll" class="btn btn-primary">전체</button>
                        <button type="button" id="documentClassSelect" class="btn btn-warning" data-toggle="modal" data-target="#documentClassSelectModal">편집</button>
                    </div>

                    <div class="docClassTree_Container">
                        <ul>
                            @foreach (var item in ViewBag.docClasses as List<T_Document_Class>)
                            {
                                RenderTree(item);
                            }
                        </ul>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <div class="col-lg-10">
        <div class="panel">
            <div class="panel-container show">
                <div class="panel-content">
                    <div class="buttons">
                        <button type="button" id="documentCreate" class="btn btn-primary" data-toggle="modal" data-target="#documentFormModal">등록</button>
                        <button type="button" id="documentEdit" class="btn btn-warning" data-toggle="modal">수정</button>
                        <button type="button" id="documentDelete" class="btn btn-danger" data-toggle="modal">삭제</button>
                        <button type="button" id="documentRevision" class="btn btn-secondary" data-toggle="modal">개정</button>
                        @*<label>
                                <input type="checkbox" name="recentCheck" value="1"> 최신 문서만 보기
                            </label>*@
                    </div>
                    <table id="DocumentMainTable" class="table table-bordered table-hover table-striped w-100">
                        <thead class="bg-warning-200">
                            <tr>
                                <th>번호</th>
                                <th>문서분류이름</th>
                                <th>문서채번</th>
                                <th>문서제목</th>
                                <th>리비전</th>
                                @*<th>상태</th>*@
                                <th>작성자</th>
                                <th>작성일</th>
                                <th>수정자</th>
                                <th>수정일</th>
                                <th>최신문서</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var doc in Model)
                            {
                                <tr data-oid="@doc.OID" ondblclick="DocumentDetail(this)">
                                    <td>
                                        @index
                                    </td>
                                    <td>
                                        @Html.DisplayFor(modelItem => doc.DOC_CLASS_NAME)
                                    </td>
                                    <td>
                                        @Html.DisplayFor(modelItem => doc.NAME)
                                    </td>
                                    <td>
                                        @Html.DisplayFor(modelItem => doc.TITLE)
                                    </td>
                                    <td>
                                        @Html.DisplayFor(modelItem => doc.REVISION)
                                    </td>
                                    @*<td>
                                        @Html.DisplayFor(modelItem => doc.STATE)
                                    </td>*@
                                    <td>
                                        @Html.DisplayFor(modelItem => doc.CREATE_USER)
                                    </td>
                                    <td>
                                        @Html.DisplayFor(modelItem => doc.CREATE_DATE)
                                    </td>
                                    <td>
                                        @Html.DisplayFor(modelItem => doc.MODIFY_USER)
                                    </td>
                                    <td>
                                        @Html.DisplayFor(modelItem => doc.MODIFY_DATE)
                                    </td>
                                    <td>
                                        @*@Html.DisplayFor(modelItem => doc.RECENT)*@
                                        @(doc.RECENT == 1 ? "O" : "X")
                                    </td>
                                </tr>
                                index++;
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>



<!-- 문서모달 -->
<div class="modal fade" id="documentFormModal" tabindex="-1" role="dialog" aria-hidden="true">
    <div class="modal-dialog" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="documentFormModalLabel"></h5>
                <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>
            <div class="modal-body">
                <form id="documentForm">
                    @*<div class="alert alert-primary text-dark"></div>*@
                    <div class="form-group">
                        <label class="form-label" for="documentFormDocClassSelect">
                            문서 분류
                        </label>
                        <select class="select2 form-control w-100" id="documentFormDocClassSelect">
                            <optgroup label="문서분류선택">
                                <option value="">문서분류선택</option>
                                @*@foreach (var item in ViewBag.docClasses)
                                    {
                                        <option value="@item.SEQ">@item.NAME</option>
                                        @if (item.Children.Count > 0)
                                        {
                                            @foreach (var child in item.Children)
                                            {
                                                <option value="@child.SEQ">@child.NAME</option>
                                            }

                                        }
                                    }*@
                            </optgroup>
                        </select>
                    </div>
                    <div class="form-group">
                        <label class="form-label" for="title">문서제목</label>
                        <input type="text" id="title" class="form-control" placeholder="">
                    </div>
                    <div class="form-group">
                        <label class="form-label" for="content">내용</label>
                        <textarea class="form-control" id="content" rows="5"></textarea>
                    </div>
                    <div class="form-group">
                        <label class="form-label" for="create_user">작성자</label>
                        <input type="text" id="create_user" class="form-control" placeholder="">
                    </div>
                    <div class="form-group">
                        <label class="form-label" for="modify_user">수정자</label>
                        <input type="text" id="modify_user" class="form-control" placeholder="">
                    </div>
                    <div class="form-group">
                        <label class="form-label" for="create_date">작성일</label>
                        <input class="form-control" id="create_date" type="date" name="date">
                    </div>
                    <div class="form-group">
                        <label class="form-label" for="modify_date">수정일</label>
                        <input class="form-control" id="modify_date" type="date" name="date">
                    </div>
                    <div class="form-group">
                        <label class="form-label" for="example-number">리비전</label>
                        <input class="form-control" id="revision" type="number" name="number" value="" readonly="readonly">
                    </div>
                    <div id="fileDownload" class="form-group">
                        @*<label id="fileDownloadList" class="form-label" for="file">첨부 파일</label>
                            <input type="file" readonly="" class="form-control-plaintext" id="file" value="">*@
                    </div>
                    <div id="fileUpload" class="form-group">
                        <label class="form-label">파일 등록</label>
                        <div class="dropzone" id="documentDropzone">
                            <div class="dz-message needsclick">
                                파일을 이곳에 드래그하거나 클릭하여 업로드하세요.
                            </div>
                        </div>
                    </div>
                    <div class="panel-content border-faded border-left-0 border-right-0 border-bottom-0 d-flex flex-row">
                        <button id="documentCreateSubmit" class="btn btn-primary ml-auto">등록</button>
                        <button id="documentEditSubmit" class="btn btn-primary ml-auto">수정</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>






@*문서분류선택 모달*@
<div class="modal fade" id="documentClassSelectModal" tabindex="-1" role="dialog" aria-labelledby="documentClassSelectModalLabel" aria-hidden="true">
    <div class="modal-dialog" role="documentClass">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="documentClassSelectModalLabel">문서분류선택</h5>
                <button type="button" class="close" data-dismiss="modal" aria-label="닫기">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>
            <div class="modal-body">
                <div class="docClassTree_Container docClassSelectContainer">
                    <ul class="doc-tree">
                        @foreach (var item in ViewBag.docClasses as List<T_Document_Class>)
                        {
                            RenderTree(item);
                        }
                    </ul>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" id="documentClassCreate" class="btn btn-primary" data-toggle="modal" data-target="#documentClassCreateModal">등록</button>
                <button type="button" id="documentClassEdit" class="btn btn-primary" data-toggle="modal">수정</button>
                <button type="button" id="documentClassDelete" class="btn btn-primary" data-toggle="modal">삭제</button>
                <button type="button" id="documentClassCancel" class="btn btn-primary" data-toggle="modal">선택취소</button>
                @*<button type="button" class="btn btn-secondary" data-dismiss="modal">닫기</button>*@
            </div>
        </div>
    </div>
</div>






@*문서분류등록모달*@
<div class="modal fade" id="documentClassCreateModal" tabindex="-1" role="dialog" aria-hidden="true">
    <div class="modal-dialog" role="documentClass">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="documentClassCreateModalLabel">문서분류등록</h5>
                <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>
            <div class="modal-body">
                <form id="documentClassCreateForm">
                    <div class="form-group">
                        <label class="form-label" for="docClassCreateLocation">문서분류선택</label>
                        <input type="text" id="docClassCreateLocation" class="form-control" placeholder="">
                        <input type="hidden" id="docClassCreateLocationSEQ" />
                    </div>
                    <div class="form-group">
                        <label class="form-label" for="docClassCreateName">문서분류이름</label>
                        <input type="text" id="docClassCreateName" class="form-control" placeholder="">
                    </div>
                    <div class="modal-footer">
                        <button type="button" id="documentClassCreateSubmit" class="btn btn-primary">완료</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>



@*문서분류편집모달*@
<div class="modal fade" id="documentClassEditModal" tabindex="-1" role="dialog" aria-hidden="true">
    <div class="modal-dialog" role="documentClass">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="documentClassEditModalLabel">문서분류편집</h5>
                <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>
            <div class="modal-body">
                <form id="documentClassEditForm">
                    <div class="form-group">
                        <label class="form-label" for="docClassEditParentLocation">문서분류선택</label>
                        <input type="hidden" id="docClassEditLocationSEQ" />
                        <select id="docClassEditParentLocation" class="form-control">
                            <option value="">-- 문서분류선택 --</option>
                        </select>
                    </div>
                    <div class="form-group">
                        <label class="form-label" for="docClassEditName">문서분류이름</label>
                        <input type="text" id="docClassEditName" class="form-control" placeholder="">
                    </div>
                    <div class="modal-footer">
                        <button type="button" id="documentClassEditSubmit" class="btn btn-primary">수정</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>





@section ScriptsBlock {
    <script type="text/javascript">$('#js-page-content').smartPanel();</script>
    <script src="~/js/statistics/peity/peity.bundle.js"></script>
    <script src="~/js/statistics/flot/flot.bundle.js"></script>
    <script src="~/js/statistics/easypiechart/easypiechart.bundle.js"></script>
    <script src="~/js/datagrid/datatables/datatables.bundle.js"></script>
    <script src="~/js/formplugins/dropzone/dropzone.js"></script>
    <script src="~/js/modules/document.js"></script>

}


