@{
    ViewData["Title"] = "문서등록";
    ViewData["PageName"] = "drawing_create";
    ViewData["Category1"] = "도면관리";
    ViewData["Heading"] = "<i class='subheader-icon fal fa-chart-area'></i> Marketing <span class='fw-300'>문서등록</span>";
}

<div class="row">
    <div class="col-xl-12">
        <div id="panel-1" class="panel">
            <div class="panel-container show">
                <div class="panel-content">
                    <form>
                        <div class="form-group">
                            <label class="form-label" for="title">도면제목</label>
                            <input type="text" id="title" class="form-control" placeholder="">
                        </div>
                        <div class="form-group">
                            <label class="form-label" for="content">내용</label>
                            <textarea class="form-control" id="content" rows="5"></textarea>
                        </div>
                        <div class="form-group">
                            <label class="form-label" for="creator">작성자</label>
                            <input type="text" readonly="" class="form-control-plaintext" id="creator" value="전정찬">
                        </div>
                        <div class="form-group">
                            <label class="form-label" for="modifier">수정자</label>
                            <input type="text" readonly="" class="form-control-plaintext" id="modifier" value="">
                        </div>
                        <div class="form-group">
                            <label class="form-label" for="example-helping">Helping text</label>
                            <input type="text" id="example-helping" class="form-control" placeholder="Helping text">
                            <span class="help-block">
                                A block of help text that breaks onto a new line and may extend beyond one line.
                            </span>
                        </div>
                        <div class="form-group">
                            <label class="form-label" for="example-fileinput">파일선택</label>
                            <input type="file" id="example-fileinput" class="form-control-file">
                        </div>
                        <div class="form-group">
                            <label class="form-label" for="createDate">작성일</label>
                            <input class="form-control" id="createDate" type="date" name="date" value="">
                        </div>
                        <div class="form-group">
                            <label class="form-label" for="modifyDate">수정일</label>
                            <input class="form-control" id="modifyDate" type="date" name="date" value="">
                        </div>
                        <div class="form-group">
                            <label class="form-label" for="example-number">Number</label>
                            <input class="form-control" id="example-number" type="number" name="number" value="1">
                        </div>
                        <div class="form-group">
                            <label class="form-label">Select (custom)</label>
                            <select class="custom-select form-control">
                                <option selected="">Open this select menu</option>
                                <option value="1">One</option>
                                <option value="2">Two</option>
                                <option value="3">Three</option>
                            </select>
                        </div>
                        <div class="form-group mb-0">
                            <label class="form-label">파일 등록</label>
                            <div class="custom-file">
                                <input type="file" class="custom-file-input" id="drawingFile">
                                <label class="custom-file-label" for="drawingFile">파일 선택</label>
                            </div>
                        </div>
                        <div class="panel-content border-faded border-left-0 border-right-0 border-bottom-0 d-flex flex-row">
                            <button class="btn btn-primary ml-auto" type="submit">등록</button>
                        </div>
                        <div class="panel-content border-faded border-left-0 border-right-0 border-bottom-0 d-flex flex-row">
                            <button class="btn btn-primary ml-auto" type="submit">수정</button>
                            <button class="btn btn-primary ml-auto" type="reset">초기화</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>
@section ScriptsBlock {
    @*<script type="text/javascript">var example_gridsize = $("#example-gridsize");
        $("#gridrange").on("input change", function () {
            //do something
            example_gridsize.attr("placeholder", ".col-" + $(this).val());
            example_gridsize.parent().removeClass().addClass("col-" + $(this).val())
            console.log("col-" + $(this).val());
        });
    </script>*@

    <script>
        $('#createDate').val(new Date().toISOString().substring(0, 10));
    </script>
}
