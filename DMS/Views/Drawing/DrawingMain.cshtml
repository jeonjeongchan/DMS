@model IEnumerable<DMS.Models.T_Drawing>
@{
    ViewData["Title"] = "메인화면";
    ViewData["PageName"] = "drawing_main";
    ViewData["Category1"] = "도면관리";
    ViewData["Heading"] = "<i class='subheader-icon fal fa-chart-area'></i> Marketing <span class='fw-300'>도면관리</span>";

}

@section HeadBlock {
    <link rel="stylesheet" media="screen, print" href="~/css/datagrid/datatables/datatables.bundle.css">
    <link rel="stylesheet" media="screen, print" href="~/css/theme-demo.css">
}

@{
    int index = 1;
}

<div class="row">
    <div class="col-lg-12">
        <div id="panel-2" class="panel">
            <div class="panel-container show">
                <div class="panel-content">
                    <div class="buttons">
                        <button type="button" id="drawingCreate" class="btn btn-primary" data-toggle="modal" data-target="#drawingFormModal">등록</button>
                        <button type="button" id="drawingEdit" class="btn btn-warning" data-toggle="modal">수정</button>
                        <button type="button" id="drawingDelete" class="btn btn-danger" data-toggle="modal">삭제</button>
                        @*<button type="button" class="btn btn-dark">Dark</button>
                            <button type="button" class="btn btn-light">Light</button>
                            <button type="button" class="btn btn-secondary">Secondary</button>
                            <button type="button" class="btn btn-success">Success</button>
                            <button type="button" class="btn btn-info">Info</button>*@
                    </div>
                    <table id="DrawingMainTable" class="table table-bordered table-hover table-striped w-100">
                        <thead class="bg-warning-200">
                            <tr>
                                <th>번호</th>
                                <th>도면이름</th>
                                <th>리비전</th>
                                <th>상태</th>
                                <th>작성자</th>
                                <th>작성일</th>
                                <th>수정자</th>
                                <th>수정일</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in Model)
                            {
                                <tr data-oid="@item.OID" ondblclick="DrawingDetail(this)">
                                    <td>
                                        @index
                                    </td>
                                    <td>
                                        @Html.DisplayFor(modelItem => item.TITLE)
                                    </td>
                                    <td>
                                        @Html.DisplayFor(modelItem => item.REVISION)
                                    </td>
                                    <td>
                                        @Html.DisplayFor(modelItem => item.STATE)
                                    </td>
                                    <td>
                                        @Html.DisplayFor(modelItem => item.CREATE_USER)
                                    </td>
                                    <td>
                                        @Html.DisplayFor(modelItem => item.CREATE_DATE)
                                    </td>
                                    <td>
                                        @Html.DisplayFor(modelItem => item.MODIFY_USER)
                                    </td>
                                    <td>
                                        @Html.DisplayFor(modelItem => item.MODIFY_DATE)
                                    </td>
                                </tr>
                                    index++;
                                }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>



<!-- 도면모달 -->
<div class="modal fade" id="drawingFormModal" tabindex="-1" role="dialog" aria-hidden="true">
    <div class="modal-dialog" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="drawingFormModalLabel"></h5>
                <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>
            <div class="modal-body">
                <form id="drawingForm">
                    <div class="form-group">
                        <label class="form-label" for="title">도면제목</label>
                        <input type="text" id="title" class="form-control" placeholder="">
                    </div>
                    <div class="form-group">
                        <label class="form-label" for="content">내용</label>
                        <textarea class="form-control" id="content" rows="5"></textarea>
                    </div>
                    <div class="form-group">
                        <label class="form-label" for="state">상태</label>
                        <input type="text" id="state" class="form-control" placeholder="">
                    </div>
                    <div class="form-group">
                        <label class="form-label" for="create_user">작성자</label>
                        <input type="text" readonly="" class="form-control-plaintext" id="create_user" value="">
                    </div>
                    <div class="form-group">
                        <label class="form-label" for="modify_user">수정자</label>
                        <input type="text" readonly="" class="form-control-plaintext" id="modify_user" value="">
                    </div>
                    <div class="form-group">
                        <label class="form-label" for="create_date">작성일</label>
                        <input class="form-control" id="create_date" type="date" name="date">
                    </div>
                    <div class="form-group">
                        <label class="form-label" for="modify_date">수정일</label>
                        <input class="form-control" id="modify_date" type="date" name="date">
                    </div>
                    <div class="form-group">
                        <label class="form-label" for="revision">리비전</label>
                        <input class="form-control" id="revision" type="number" name="number" value="" readonly="readonly">
                    </div>
                    <div id="fileSelect" class="form-group mb-0">
                        <label class="form-label">파일 등록</label>
                        <div class="custom-file">
                            <input type="file" class="custom-file-input" id="drawingFile">
                            <label class="custom-file-label" for="drawingFile">파일 선택</label>
                        </div>
                    </div>
                    <div class="panel-content border-faded border-left-0 border-right-0 border-bottom-0 d-flex flex-row">
                        <button id="drawingCreateSubmit" class="btn btn-primary">등록</button>
                        <button id="drawingEditSubmit" class="btn btn-primary">편집</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>


@section ScriptsBlock {
    <script type="text/javascript">/* Activate smart panels */
        $('#js-page-content').smartPanel();</script>
    <script src="~/js/statistics/peity/peity.bundle.js"></script>
    <script src="~/js/statistics/flot/flot.bundle.js"></script>
    <script src="~/js/statistics/easypiechart/easypiechart.bundle.js"></script>
    <script src="~/js/datagrid/datatables/datatables.bundle.js"></script>
    <script>


        function dateChange(dateInput) {
            if (dateInput != "" && dateInput != null) {
                var dateObject = new Date(dateInput);
                var isoDateString = dateObject.toISOString();

                return isoDateString;

            } else {
                return null;
            }

        }

        function createFormDateChange(today) {
            if (today == null || today == undefined) {
                today = new Date();
                var dd = String(today.getDate()).padStart(2, '0');
                var mm = String(today.getMonth() + 1).padStart(2, '0');
                var yyyy = today.getFullYear();
                today = yyyy + '-' + mm + '-' + dd;
            } else {
                today = today.substring(0, 10);
            }

            return today;
        }


        // 도면상세
        function DrawingDetail(row) {
            const oid = row.getAttribute('data-oid');

            $('#drawingFormModalLabel').text('도면상세');
            $('#drawingForm input').attr('readonly', 'readonly');
            $('#drawingForm textarea').attr('readonly', 'readonly');
            $('#state').attr('readonly', 'readonly');
            $('#revision').attr('readonly', 'readonly');
            $('#fileSelect').hide();
            $('#drawingCreateSubmit').hide();
            $('#drawingEditSubmit').hide();

            $.ajax({
                url: '/Drawing/' + oid,
                type: 'GET',
                success: function (data) {
  
                    $('#drawingFormModal').modal('show');
                    $('#title').val(data.title);
                    $('#content').val(data.content);
                    if (data.creatE_DATE != undefined || data.creatE_DATE != null) {
                        $('#create_date').val(createFormDateChange(data.creatE_DATE));
                    } else {
                        $('#create_date').val(null);
                    }

                    if (data.modifY_DATE != undefined || data.modifY_DATE != null) {
                        $('#modify_date').val(createFormDateChange(data.modifY_DATE));
                    } else {
                        $('#modify_date').val(null);
                    }
                    $('#create_user').val(data.creatE_USER);
                    $('#modify_user').val(data.modifY_USER);
                    $('#revision').val(data.revision);
                    $('#state').val(data.state);

                },
                error: function (xhr, status, error) {
                    console.log('Error:', error);
                }
            });
        }


        $(document).ready(function () {

            var drawingId = null;

            // 도면편집
            $('#drawingEdit').on('click', function () {
                
                drawingId = null;
                var count = $("#DrawingMainTable tr").filter(function () {
                    return $(this).hasClass('selected');
                }).length;

                if (count > 1) {
                    alert("도면 하나만 선택해주세요.");
                } else if (count == 0) {
                    alert("도면 하나를 선택해주세요.");
                } else {
                    drawingId = $("tbody tr.selected").data("oid");

                    $('#drawingFormModalLabel').text('도면편집');
                    $('#drawingForm input').removeAttr('readonly');
                    $('#fileSelect').show();
                    $('#drawingForm textarea').removeAttr('readonly');
                    $('#create_user').attr('readonly', 'readonly');
                    $('#modify_user').attr('readonly', 'readonly');
                    $('#create_date').attr('readonly', 'readonly');
                    $('#modify_date').attr('readonly', 'readonly');
                    $('#state').attr('readonly', 'readonly');
                    $('#revision').attr('readonly', 'readonly');
                    $('#drawingCreateSubmit').hide();
                    $('#drawingEditSubmit').show();

                    $.ajax({
                        url: '/Drawing/' + drawingId,
                        type: 'GET',
                        success: function (data) {
                            debugger;
                            $('#drawingFormModal').modal('show');
                            $('#title').val(data.title);
                            $('#content').val(data.content);

                            if (data.creatE_DATE != undefined || data.creatE_DATE != null) {
                                $('#create_date').val(createFormDateChange(data.creatE_DATE));
                            } else {
                                $('#create_date').val(null);
                            }

                            if (data.modifY_DATE != undefined || data.modifY_DATE != null) {
                                $('#modify_date').val(createFormDateChange(data.modifY_DATE));
                            } else {
                                $('#modify_date').val(null);
                            }

                            $('#create_user').val(data.creatE_USER);
                            $('#modify_user').val(data.modifY_USER);
                            $('#revision').val(data.revision);
                            $('#state').val(data.state);
                        },
                        error: function (xhr, status, error) {
                            console.log('Error:', error);
                            window.location.href = '/Error';
                        }
                    });

                }

            });

            // 도면삭제
            $('#drawingDelete').on('click', function () {
                var selectedOids = [];
                var count = $("#DrawingMainTable tr").filter(function () {
                    return $(this).hasClass('selected');
                }).length;

                // 선택된 tr의 data-oid를 추출
                $("tbody tr.selected").each(function () {
                    var oid = $(this).data("oid");
                    selectedOids.push(oid); // 배열에 추가
                });

                if (count == 0) {
                    alert("삭제할 도면을 선택해주세요.");
                } else {
                    event.preventDefault();
                    if (confirm("삭제 하시겠습니까?")) {
                        $.ajax({
                            url: '/Drawing/Delete',
                            type: 'DELETE',
                            contentType: 'application/json',
                            data: JSON.stringify({ OIDs: selectedOids }),
                            success: function (data) {
                                alert('도면 삭제 성공');
                                //if ($("#DrawingMainTable tr").hasClass('selected')) {
                                //    $("#DrawingMainTable tr").removeClass('selected');
                                //}
                                window.location.href = '/Drawing';
                                
                            },
                            error: function (xhr, status, error) {
                                console.log('Error:', error);
                                window.location.href = '/Error';
                            }
                        });
                    }
                }

            });

            // 도면등록
            $('#drawingCreate').on('click', function () {
                drawingId = null;
                $('#drawingForm')[0].reset();
                $('#drawingFormModalLabel').text('도면등록');
                //isFormEdit(drawingId, false);
                $('#drawingForm input').removeAttr('readonly');
                $('#drawingForm textarea').removeAttr('readonly');
                $('#modifyDate').attr('readonly', 'readonly');
                $('#fileSelect').show();
                $('#drawingCreateSubmit').show();
                $('#drawingEditSubmit').hide();
                if ($("#DrawingMainTable tr").hasClass('selected')) {
                    $("#DrawingMainTable tr").removeClass('selected');
                }
                $('#create_date').val(createFormDateChange(null));
            });

            // 도면등록 완료
            $('#drawingCreateSubmit').on("click", async function () {
                event.preventDefault();
                if (confirm("등록 하시겠습니까?")) {
                    debugger;
                    var formData = new FormData();
                    var method = 'POST';
                    var urlMethod = '/Drawing';

                    formData.append("TITLE", $('#title').val());
                    formData.append("CONTENT", $('#content').val());

                    var fileFormData = $("#drawingFile")[0].files[0];
                    if (fileFormData) {
                        formData.append("T_File", fileFormData);
                    }

                    const response = await fetch(urlMethod, {
                        method: method,
                        body: formData
                    })
                        .then(response => {
                            if (!response.ok) {
                                throw new Error("Failed to save post and file.");
                            }
                            return response.json();
                        })
                        .then(data => {
                            alert("Success: " + data.message);
                        })
                        .catch(error => {
                            console.error("Error:", error);
                            alert("Error: " + error.message);
                        });
                }

            });

            // 도면편집 완료
            $('#drawingEditSubmit').on('click', function () {
                event.preventDefault();
                if (confirm("수정 하시겠습니까?")) {                    
                    debugger;
                    var method = 'PUT';
                    var urlMethod = '/Drawing/' + drawingId;

                    var createDateChange = dateChange($('#create_date').val());
                    var modifyDateChange = modifyDateChange = new Date();
                    var fileUpload = $("#drawingFile")[0].files[0];


                    var formData = {
                        oid: drawingId,
                        type: "DRAWING",
                        title: $('#title').val(),
                        content: $('#content').val(),
                        state: "작성중",
                        revision: 0,
                        create_user: $('#create_user').val(),
                        modify_user: $('#modify_user').val(),
                        create_date: createDateChange,
                        modify_date: modifyDateChange,
                        useflag: '1'
                    };

                    $.ajax({
                        type: method,
                        url: urlMethod,
                        data: JSON.stringify(formData),
                        contentType: 'application/json; charset=utf-8',
                        dataType: 'json',
                        success: function (response) {
                            alert('도면 수정 완료');
                            window.location.href = '/Drawing';
                        },
                        error: function (xhr, status, error) {
                            alert('Error: ' + error);
                        }
                    });
                }

            });

        });

        $('#DrawingMainTable').dataTable({
            responsive: true,
            dom:
                /*	--- Layout Structure
                    --- Options
                    l	-	length changing input control
                    f	-	filtering input
                    t	-	The table!
                    i	-	Table information summary
                    p	-	pagination control
                    r	-	processing display element
                    B	-	buttons
                    R	-	ColReorder
                    S	-	Select
                    --- Markup
                    < and >				- div element
                    <"class" and >		- div with a class
                    <"#id" and >		- div with an ID
                    <"#id.class" and >	- div with an ID and a class
                    --- Further reading
                    https://datatables.net/reference/option/dom
                    --------------------------------------
                 */
                "<'row mb-3'<'col-sm-12 col-md-6 d-flex align-items-center justify-content-start'f><'col-sm-12 col-md-6 d-flex align-items-center justify-content-end'B>>" +
                "<'row'<'col-sm-12'tr>>" +
                "<'row'<'col-sm-12 col-md-5'i><'col-sm-12 col-md-7'p>>",
            select: 'multiple',
            //columns: columnSet,
            //altEditor: true,
            //responsive: true,
            buttons: [
                //{
                //    text: '등록',
                //    //data-target: '#writeFormModal',
                //    //data-toggle: 'modal'
                //    className: 'btn-outline-default'
                //}
                //{
                //    extend: 'colvis',
                //    text: 'Column Visibility',
                //    titleAttr: 'Col visibility',
                //    className: 'btn-outline-default'
                //},
                //{
                //    extend: 'csvHtml5',
                //    text: 'CSV',
                //    titleAttr: 'Generate CSV',
                //    className: 'btn-outline-default'
                //},
                //{
                //    extend: 'copyHtml5',
                //    text: 'Copy',
                //    titleAttr: 'Copy to clipboard',
                //    className: 'btn-outline-default'
                //},
                //{
                //    extend: 'print',
                //    text: 'Print',
                //    titleAttr: 'Print Table',
                //    className: 'btn-outline-default'
                //},
                //{
                //    extend: 'selected',
                //    text: '<i class="fal fa-times mr-1"></i> 삭제',
                //    name: 'delete',
                //    className: 'btn-primary btn-sm mr-1'
                //},
                //{
                //    extend: 'selected',
                //    text: '<i class="fal fa-edit mr-1"></i> 수정',
                //    name: 'edit',
                //    className: 'btn-primary btn-sm mr-1'
                //},
                //{
                //    text: '<i class="fal fa-plus mr-1"></i> 등록',
                //    name: 'add',
                //    className: 'btn-success btn-sm mr-1'
                //},
                //{
                //    text: '<i class="fal fa-sync mr-1"></i> 새로고침',
                //    name: 'refresh',
                //    className: 'btn-primary btn-sm'
                //}
            ]
        });
    </script>
}


