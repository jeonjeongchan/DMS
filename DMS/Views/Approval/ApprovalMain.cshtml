@using Microsoft.AspNetCore.Http
@using DMS.Models

@model IEnumerable<T_Approval>

@{
    ViewData["Title"] = "메인화면";
    ViewData["PageName"] = "approval_approval";
    ViewData["Category1"] = "결재관리";
    ViewData["Heading"] = "<i class='subheader-icon fal fa-chart-area'></i> Marketing <span class='fw-300'>결재관리</span>";
}

@section HeadBlock {
    <link rel="stylesheet" media="screen, print" href="~/css/datagrid/datatables/datatables.bundle.css">
    <link rel="stylesheet" media="screen, print" href="~/css/theme-demo.css">
    <link rel="stylesheet" media="screen, print" href="~/css/fa-solid.css">
    <link rel="stylesheet" media="screen, print" href="~/css/fa-brands.css">
}

<!-- 🪟 모달 폼 영역 -->
<div id="approvalModalContainer"></div>


<div class="row">
    <div class="col-lg-12">
        <div class="panel">
            <div class="panel-container show">
                <div class="panel-content">
                    <div class="buttons">
                            <button type="button" id="" class="btn btn-primary" onclick="approvalCreateModal()">등록</button>
                            <button type="button" id="" class="btn btn-warning" data-toggle="modal">수정</button>
                            <button type="button" id="" class="btn btn-danger" data-toggle="modal">삭제</button>
                        </div>
                    <table id="ApprovalMainTable" class="table table-bordered table-hover table-striped w-100">
                        <thead class="bg-warning-200">
                            <tr>
                                <th>결재번호</th>
                                <th>결재이름</th>
                                <th>결재타입</th>
                                <th>상태</th>
                                <th>작성자</th>
                                <th>작성일</th>
                                <th>결재완료일</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var app in Model)
                            {
                                <tr data-oid="@app.OID" ondblclick="">
                                    <td>
                                        @Html.DisplayFor(modelItem => app.NAME)
                                    </td>
                                    <td>
                                        @Html.DisplayFor(modelItem => app.TITLE)
                                    </td>
                                    <td>
                                        @Html.DisplayFor(modelItem => app.SUBTYPE)
                                    </td>
                                    <td>
                                        @Html.DisplayFor(modelItem => app.STATE)
                                    </td>
                                    <td>
                                        @Html.DisplayFor(modelItem => app.CREATE_USER)
                                    </td>
                                    <td>
                                        @Html.DisplayFor(modelItem => app.CREATE_DATE)
                                    </td>
                                    <td>
                                        @Html.DisplayFor(modelItem => app.APPROVE_DATE)
                                    </td>
                                </tr>

                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>


@section ScriptsBlock {
    <script type="text/javascript">$('#js-page-content').smartPanel();</script>
    <script src="~/js/statistics/peity/peity.bundle.js"></script>
    <script src="~/js/statistics/flot/flot.bundle.js"></script>
