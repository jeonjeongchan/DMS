@model T_Approval

<div class="modal fade" id="approvalModal" tabindex="-1" role="dialog" aria-labelledby="approvalModalLabel">
    <div class="modal-dialog modal-lg" role="document">
        <div class="modal-content">
            <form id="approvalForm" method="post" action="@((Model.OID == null) ? Url.Action("CreateApproval", "Approval")  : Url.Action("Edit"))">
                <div class="modal-header">
                    <h5 class="modal-title" id="approvalModalLabel">
                        @((Model.OID == null) ? "결재 등록" : "결재 편집")
                    </h5>
                    <button type="button" class="close" data-dismiss="modal" aria-label="Close"></button>
                </div>

                <div class="modal-body">
                    <input type="hidden" asp-for="OID" id="approvalOID" />

                    <div class="mb-3">
                        <label asp-for="NAME" class="form-label">결재 제목</label>
                        <input asp-for="NAME" class="form-control" id="approvalName" />
                        <span asp-validation-for="NAME" class="text-danger"></span>
                    </div>
                    <div class="mb-3">
                        <label asp-for="CONTENT" class="form-label">결재 내용</label>
                        <textarea asp-for="CONTENT" class="form-control" rows="5" id="approvalContent"></textarea>
                        <span asp-validation-for="CONTENT" class="text-danger"></span>
                    </div>
                    <div class="mb-3">
                        <label class="form-label">첨부 파일</label>
                        <input type="file" class="form-control" multiple />
                        <span class="text-danger"></span>
                    </div>

                    <div class="row">
                        <div class="col-md-6">
                            <h6>전체 결재자</h6>
                            <ul id="allMembers" class="list-group min-vh-50 border p-2">
                                <li class="list-group-item">홍길동</li>
                                <li class="list-group-item">이순신</li>
                                <li class="list-group-item">강감찬</li>
                                <li class="list-group-item">유관순</li>
                            </ul>
                        </div>

                        <div class="col-md-6">
                            <h6>선택된 결재자</h6>
                            <ul id="selectedMembers" class="list-group min-vh-50 border p-2 bg-light">
                                <!-- 편집 모드 시 기존 결재자 표시 -->
                                @*@if (Model.SelectedApprovers != null && Model.SelectedApprovers.Any())
                    {
                        foreach (var approver in Model.SelectedApprovers)
                        {
                            <li class="list-group-item bg-primary text-white fw-bold">
                                @approver
                                <span class="ms-2 badge bg-danger remove-approver" style="cursor:pointer;">x</span>
                            </li>
                        }
                    }*@
                            </ul>
                        </div>
                    </div>
                </div>

                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-dismiss="modal">취소</button>
                    <button type="submit" class="btn btn-primary">저장</button>
                </div>
            </form>
        </div>
    </div>
</div>

<link href="https://cdn.quilljs.com/1.3.6/quill.snow.css" rel="stylesheet">
<script src="https://cdn.quilljs.com/1.3.6/quill.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/sortablejs@1.15.0/Sortable.min.js"></script>
<script>
    $(document).ready(function () {

        let allMembersList, selectedMembersList;

        // 모달이 열릴 때 실행
        $('#approvalModal').on('shown.bs.modal', function () {
            const oid = $('#approvalOID').val();
            const isEditMode = oid && oid.trim() !== '';

            // 제목 입력칸 편집 모드 시 readonly 처리
            if (isEditMode) {
                $('#approvalName').attr('readonly', true);
            } else {
                $('#approvalName').removeAttr('readonly');
            }

            // Sortable 초기화
            if (!allMembersList) {
                allMembersList = new Sortable(document.getElementById('allMembers'), {
                    group: 'shared',
                    animation: 150,
                    sort: false, // 전체 결재자는 순서 변경 불가
                    disabled: isEditMode // 편집 모드에서는 드래그 불가
                });
            }

            if (!selectedMembersList) {
                selectedMembersList = new Sortable(document.getElementById('selectedMembers'), {
                    group: 'shared',
                    animation: 150,
                    sort: true,
                    disabled: isEditMode, // 편집 모드에서는 결재 순서 수정 불가
                    onAdd: function (evt) {
                        $(evt.item)
                            .addClass("bg-primary text-white fw-bold")
                            .append('<span class="ms-2 badge bg-danger remove-approver" style="cursor:pointer;">x</span>');
                    },
                    onRemove: function (evt) {
                        $(evt.item).removeClass("bg-primary text-white fw-bold");
                        $(evt.item).find(".remove-approver").remove();
                    }
                });
            }

            // 결재자 삭제 버튼
            $('#selectedMembers').off('click', '.remove-approver').on('click', '.remove-approver', function () {
                const $li = $(this).closest('li');
                $('#allMembers').append($li);
                $li.removeClass("bg-primary text-white fw-bold");
                $(this).remove();
            });
        });

        // 모달 닫힐 때 초기화
        $('#approvalModal').on('hidden.bs.modal', function () {
            $('#approvalForm')[0].reset();
            $('#selectedMembers').empty();
            $('#allMembers li').removeClass("bg-primary text-white fw-bold");
            $('#allMembers li .remove-approver').remove();
            $('#approvalName').removeAttr('readonly');
        });

        // 폼 전송 시 선택된 결재자 목록을 hidden input으로 추가
        $('#approvalForm').on('submit', function () {

            debugger;
            var data = {
                NAME: $("#approvalName").val(),
                CONTENT: $("#approvalContent").val()
            };

            $.ajax({
                url: '/Approval/CreateApproval',
                type: 'POST',
                contentType: 'application/json',
                data: JSON.stringify(data),
                success: function (result) {
                    if (result.success) {
                        $("#approvalForm")[0].reset(); // 폼 초기화
                    }
                },
                error: function (xhr, status, error) {
                    console.error(xhr.responseText);
                }
            });


            //const selected = $('#selectedMembers li').map(function () {
            //    return $(this).text().replace('x', '').trim();
            //}).get();

            //$('<input>').attr({
            //    type: 'hidden',
            //    name: 'SelectedApprovers',
            //    value: JSON.stringify(selected)
            //}).appendTo(this);




        });


    });

</script>

