@using Microsoft.AspNetCore.Http
@{
    var username = Context.Session.GetString("Username");
    var userId = Context.Session.GetString("UserId");
    var userOID = Context.Session.GetString("OID");
    var grade = Context.Session.GetString("Grade");
}

<div id="server-data" data-oid="@userOID" data-user-id="@userId"></div>

<div class="dropdown-header bg-trans-gradient d-flex flex-row py-4 rounded-top">
    <div class="d-flex flex-row align-items-center mt-1 mb-1 color-white">
        <span class="mr-2">
            <img src="~/img/demo/avatars/avatar-m.png" class="rounded-circle profile-image" alt="">
        </span>
        <div class="info-card-text">
            <div class="fs-lg text-truncate text-truncate-lg">
                환영합니다
                <br>
                @username @((grade == "MANAGER") ? "(관리자)" : "") 님
            </div>
            @*<span class="text-truncate text-truncate-md opacity-80">email</span>*@
        </div>
    </div>
</div>
<div class="dropdown-divider m-0"></div>
@*<a class="dropdown-item" asp-controller="Account" asp-action="MyInfo">
        <span>내 정보</span>
    </a>*@
<a class="dropdown-item" onclick="loadMyInfo()">
   <span>내 정보</span>
</a>
<a class="dropdown-item fw-500 pt-3 pb-3" asp-controller="Account" asp-action="Logout">
    <span data-i18n="drpdwn.page-logout">로그아웃</span>
</a>

<script>

    function dateChange(dateInput) {
        if (dateInput != "" && dateInput != null) {
            debugger;
            var dateObject = new Date(dateInput);
            var isoDateString = dateObject.toISOString();

            return isoDateString;

        } else {
            return null;
        }

    }

    function createFormDateChange(today) {
        if (today == null || today == undefined) {
            return today;
        } else {
            today = today.substring(0, 10);
        }
        return today;
    }

    function loadMyInfo() {
        $.ajax({
            url: '/Account/MyInfo',
            type: 'GET',
            success: function (data) {
                debugger;
                $('#myInfoCancel').hide();
                $('#myInfoSubmit').hide();
                //$('#myInfoPasswordDiv').hide();
                $('#myInfoEdit').show();
                $("#myInfoForm").find("input, textarea, select").attr("disabled", true);
                $('#myInfoForm')[0].reset();
                $('#myInfoFormModal').modal('show');
                $('#myInfoID').val(data.MEMBER_ID);
                $('#myInfoName').val(data.NAME);
                $('#myInfoBirthDate').val(createFormDateChange(data.BIRTH_DATE));
                $('#myInfoResignDate').val(createFormDateChange(data.RESIGN_DATE));
                $('#myInfoGender').val(data.GENDER);
                $('#myInfoEmail').val(data.EMAIL);
            },
            error: function (xhr, status, error) {
                console.log('Error:', error);
            }
        });
    }

    $(document).ready(function () {

        $("#myInfoEdit").click(function () {
            event.preventDefault();
            $('#myInfoCancel').show();
            $('#myInfoSubmit').show();
            $('#myInfoEdit').hide();
            //$('#myInfoPasswordDiv').show();
            $("#myInfoForm").find("input, textarea, select").attr("disabled", false);
            $("#myInfoID").attr("readonly", true);
