        $('#myInfoSubmit').on('click', async function (event) {
            event.preventDefault();

            const form = $("#myInfoForm");

            if (!form[0].checkValidity()) {
                form.addClass('was-validated');
                return;
            }

            const userOID = document.getElementById('server-data').dataset.oid;

            if (!confirm("수정 하시겠습니까?")) return;

            const data = {
                OID: userOID,
                MEMBER_ID: $('#myInfoID').val(),
                NAME: $('#myInfoName').val(),
                BIRTH_DATE: dateChange($('#myInfoBirthDate').val()),
                RESIGN_DATE: dateChange($('#myInfoResignDate').val()),
                GENDER: $('#myInfoGender').val(),
                PASSWORD: $('#myInfoPassword').val(),
                EMAIL: $('#myInfoEmail').val()
            };

            try {
                const response = await fetch(`/Account/Edit/${userOID}`, {
                    method: 'PUT',
                    headers: { "Content-Type": "application/json" },
                    body: JSON.stringify(data)
                });

                if (!response.ok) throw new Error("문제가 발생하였습니다. 관리자에게 문의하세요.");

                const result = await response.json();
                alert(result.message);

                // ✅ 모달 닫기
                $('#myInfoFormModal').modal('hide');

                // 닫혔다가 다시 열릴 때 최신 데이터 불러오도록 캐시 제거
                $('#myInfoFormModal').on('hidden.bs.modal', function () {
                    $(this).removeData('bs.modal');
                });

            } catch (error) {
                console.error("Error:", error);
                alert("Error: " + error.message);
            }
        });

    });

