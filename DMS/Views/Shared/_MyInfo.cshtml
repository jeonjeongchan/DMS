                    </div>*@
                    <div class="form-group">
                        <label class="form-label" for="NAME">이름</label>
                        <input id="myInfoName" type="text" class="form-control" value="" placeholder="">
                    </div>
                    <div class="form-group">
                        <label class="form-label" for="BIRTH_DATE">생년월일</label>
                        <input id="myInfoBirthDate" type="date" class="form-control" value="" placeholder="">
                    </div>
                    <div class="form-group">
