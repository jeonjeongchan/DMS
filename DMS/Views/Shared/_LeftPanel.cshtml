<aside class="page-sidebar">
    <partial name="_Logo" />
    <nav id="js-primary-nav" class="primary-nav" role="navigation">
        <ul id="DMS_LeftMenu" class="nav-menu">
        </ul>
    </nav>
</aside>

    <script src="https://ajax.googleapis.com/ajax/libs/jquery/3.5.1/jquery.min.js"></script>
    <script>
        $(document).ready(function () {
            $.ajax({
                url: "/Menu/CreateMenu",
                dataType: "json",
                type: "get",
                success: function (data) {
                    debugger;
                    let menu = data;
                    let array = [];
                    data.$values.forEach((m, index) => {
                        array.push("<li class='DMS_LeftMenu_li' order='" + m.ORDER + "' menuName='" + m.NAME + "' address='" + m.ADDRESS + "'><a href='" + m.ADDRESS + "'><i class='" + m.ICON + "'></i><span class='nav-link-text'>" + m.NAME + "</span></a></li>")
                    });

                    var currentUrl = window.location.pathname;

                    $("#DMS_LeftMenu").append(array);

                    let menuAll = $("#DMS_LeftMenu > li");
                    let menuAttr = $(".DMS_LeftMenu_li");

                    if (currentUrl === '/') {
                        $.each(menuAttr, function (i, e) {

                            let menuName = $(e).attr("menuName");
                            let address = $(e).attr("address");

                            if (currentUrl === address) {
                                $(e).addClass('active');
                                return;
                            }

                        });
                    } else {
                        $.each(menuAttr, function (i, e) {

                            let menuName = $(e).attr("menuName");
                            let address = $(e).attr("address");

                            if (currentUrl.indexOf(address) !== -1 && address !== '/') {  // URL이 포함되어 있으면
                                $(e).addClass('active');                               
                            }

                        });
                    }



                },
                error: function (data) {
                    alert("Error");
                }
            });

        });
    </script>



